@model CarGarage.ViewModels.Customers.CustomerDetailsViewModel
@{
    ViewData["Title"] = "Потвърждение за изтриване на клиент";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow border-0 rounded-4">
                <div class="card-header bg-danger text-white py-4 rounded-top-4">
                    <h3 class="text-center mb-0 fw-bold">
                        <i class="bi bi-exclamation-triangle-fill me-2 col-white"></i>Потвърждение за изтриване
                    </h3>
                </div>
                <div class="card-body p-5">
                    <h4 class="text-center text-dark fw-bold mb-4">Сигурни ли сте че искате да изтриете този клиент?</h4>

                    <div class="p-4 bg-light rounded-3 border border-danger border-opacity-25 mb-4">
                        <div class="mb-2"><strong>Име / Фирма:</strong> @Model.DisplayName</div>
                        <div class="mb-2"><strong>Тип клиент:</strong> @Model.CustomerType</div>
                        @if (!string.IsNullOrEmpty(Model.Email))
                        {
                            <div class="mb-2"><strong>Email:</strong> @Model.Email</div>
                        }
                        @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                        {
                            <div class="mb-2"><strong>Телефон:</strong> @Model.PhoneNumber</div>
                        }
                        @if (!string.IsNullOrEmpty(Model.UniqueNumber))
                        {
                            <div class="mb-2"><strong>ЕГН / ЕИК:</strong> @Model.UniqueNumber</div>
                        }
                        @if (!string.IsNullOrEmpty(Model.City) || !string.IsNullOrEmpty(Model.Address))
                        {
                            <div class="mb-2"><strong>Адрес:</strong> гр. @Model.City, @Model.Address</div>
                        }

                        @if (Model.Cars != null && Model.Cars.Any())
                        {
                            <div class="mt-3 pt-3 border-top text-danger">
                                <strong>Свързани автомобили (@Model.Cars.Count), които също ще бъдат премахнати:</strong>
                                <ul class="mb-0 mt-1 pl-3">
                                    @foreach (var car in Model.Cars)
                                    {
                                        <li>@car.Make @car.Model (@car.RegistrationNumber)</li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>

                    <div class="alert alert-warning d-flex align-items-start mb-4" role="alert">
                        <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                        <div>
                            <strong>Бележка:</strong> Изтриването на този клиент ще премахне клиента и неговите свързани автомобили от списъците на сервиза. 
                            Всички издавани досега <strong>фактури ще останат напълно запазени</strong> в историята на фактурите!
                        </div>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg fw-bold shadow-sm">
                                <i class="bi bi-trash-fill me-2"></i>Да, изтрий клиента и неговите автомобили
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-x-circle me-2"></i>Отказ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
