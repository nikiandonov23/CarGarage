@model CarGarage.ViewModels.Customers.CustomerIndexViewModel

@{
    ViewData["Title"] = "Клиенти";
}

<!-- Добавяме CSS за ефектите при минаване с мишката и курсора -->
<style>
    .clickable-row {
        transition: all 0.2s ease-in-out;
        cursor: pointer;
    }

        .clickable-row:hover {
            background-color: rgba(0, 0, 0, 0.05) !important; /* Леко потъмняване на фона */
            transform: scale(1.01); /* Леко уголемяване */
            box-shadow: 0 4px 8px rgba(0,0,0,0.05); /* Лека сянка за дълбочина */
        }
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-users"></i> Управление на клиенти</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Нов Клиент</a>
    </div>

    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Търси по име, телефон, имейл или ЕИК/ЕГН...">
            <button class="btn btn-outline-secondary" type="submit">
                <i class="fas fa-search"></i> Търси
            </button>
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a asp-action="Index" class="btn btn-outline-danger">Изчисти</a>
            }
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover shadow-sm align-middle">
            <thead class="table-dark">
                <tr>
                    <th style="width: 150px;">Тип</th>
                    <th>Име / Фирма</th>
                    <th>Телефон</th>
                    <th>Град</th>
                    <th>ЕГН/ЕИК</th>
                    <th>Коли</th>
                    <th class="text-center" style="width: 200px;">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model.Customers)
                {
                    <!-- Добавен е клас clickable-row и data-url, който взима линка към Details -->
                    <tr class="clickable-row" data-url="@Url.Action("Details", "Customers", new { id = customer.Id })">
                        <td>
                            <span class="badge @(customer.CustomerType == "Физическо лице" ? "bg-info text-dark" : "bg-warning text-dark")">
                                @customer.CustomerType
                            </span>
                        </td>
                        <td><strong>@customer.DisplayName</strong></td>
                        <td>@customer.PhoneNumber</td>
                        <td>@customer.City</td>
                        <td>@customer.UniqueNumber</td>
                        <td><span class="badge bg-secondary">@customer.CarsCount</span></td>
                        <td class="text-center">
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-sm btn-success" title="Виж картон">
                                    <i class="fas fa-eye"></i> Картон
                                </a>
                                <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-sm btn-warning" title="Редактирай">
                                    <i class="fas fa-edit"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Пренасочване при клик върху реда на таблицата (освен ако не е натиснат бутон)
            $('.clickable-row').click(function(e) {
                // Ако потребителят е кликнал директно върху бутоните в колоната "Действия", не правим нищо тук
                if ($(e.target).closest('a, button, .btn-group').length) {
                    return;
                }
                var url = $(this).data('url');
                if (url) {
                    window.location.href = url;
                }
            });
        });
    </script>
}