@model CarGarage.ViewModels.Customers.CustomerDetailsViewModel

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body text-center">
                    <i class="bi @(Model.CustomerType == "Физическо лице" ? "bi-person-circle" : "bi-building") display-1 text-primary mb-3"></i>
                    <h3 class="fw-bold">@Model.DisplayName</h3>
                    <p class="text-muted">@Model.CustomerType</p>
                    <div class="badge bg-success fs-6 mb-3">Общо: @Model.TotalSpent.ToString("F2") €</div>
                    <hr>
                    <ul class="list-unstyled text-start small">
                        <li class="mb-2"><strong>Email:</strong> @Model.Email</li>
                        <li class="mb-2"><strong>Тел:</strong> @Model.PhoneNumber</li>
                        <li class="mb-2"><strong>Град:</strong> @Model.City</li>
                        <li class="mb-2"><strong>Адрес:</strong> @Model.Address</li>
                        <li class="mb-2"><strong>ЕГН/ЕИК:</strong> @Model.UniqueNumber</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <ul class="nav nav-tabs card-header-tabs" id="myTab" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#cars" type="button">Автомобили (@Model.Cars.Count)</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#history" type="button">История на ремонтите</button>
                        </li>
                    </ul>
                </div>
                <div class="card-body">
                    <div class="tab-content">

                        <div class="tab-pane fade show active" id="cars">
                            <div class="row row-cols-1 row-cols-md-2 g-3 mt-2">
                                @foreach (var car in Model.Cars)
                                {
                                    <div class="col">
                                        <div class="card h-100 border shadow-sm">
                                            @if (car.CarImages != null && car.CarImages.Any())
                                            {
                                                var carouselId = $"carouselCar{car.Id}";
                                                <div id="@carouselId" class="carousel slide border-bottom" data-bs-ride="false">
                                                    <div class="carousel-indicators">
                                                        @for (int idx = 0; idx < car.CarImages.Count; idx++)
                                                        {
                                                            <button type="button" data-bs-target="#@carouselId" data-bs-slide-to="@idx" class="@(idx == 0 ? "active" : "")" aria-current="@(idx == 0 ? "true" : "false")" aria-label="Слайд @(idx + 1)"></button>
                                                        }
                                                    </div>
                                                    <div class="carousel-inner" style="height: 180px;">
                                                        @for (int idx = 0; idx < car.CarImages.Count; idx++)
                                                        {
                                                            var img = car.CarImages[idx];
                                                            <div class="carousel-item @(idx == 0 ? "active" : "")" style="height: 180px;">
                                                                <a href="/MyCars?carId=@car.Id" title="Преглед на картон на автомобила">
                                                                    <img src="@img.ImageUrl" class="d-block w-100 h-100" style="object-fit: cover;" alt="Снимка на кола">
                                                                </a>
                                                            </div>
                                                        }
                                                    </div>
                                                    @if (car.CarImages.Count > 1)
                                                    {
                                                        <button class="carousel-control-prev" type="button" data-bs-target="#@carouselId" data-bs-slide="prev">
                                                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                                            <span class="visually-hidden">Предишна</span>
                                                        </button>
                                                        <button class="carousel-control-next" type="button" data-bs-target="#@carouselId" data-bs-slide="next">
                                                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                                            <span class="visually-hidden">Следваща</span>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                            else if (!string.IsNullOrEmpty(car.ImageUrl))
                                            {
                                                <a href="/MyCars?carId=@car.Id" title="Преглед на картон на автомобила">
                                                    <img src="@car.ImageUrl" class="card-img-top border-bottom" alt="Car Image" style="height: 180px; object-fit: cover;">
                                                </a>
                                            }
                                            else
                                            {
                                                <div class="bg-light text-center py-5 border-bottom" style="height: 180px; display: flex; align-items: center; justify-content: center;">
                                                    <i class="bi bi-car-front-fill display-4 text-secondary"></i>
                                                </div>
                                            }
                                            <div class="card-body">
                                                <h6 class="fw-bold">@car.Make @car.Model</h6>
                                                <p class="text-danger small fw-bold mb-3">@car.RegistrationNumber</p>
                                                <a href="/MyCars?carId=@car.Id" class="btn btn-sm btn-dark w-100">Картон на кола</a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <a asp-controller="Customers" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                                <i class="bi bi-trash me-1"></i>Изтрий клиент
                            </a>
                        </div>

                        <div class="tab-pane fade" id="history">
                            <div class="table-responsive mt-3">
                                <table class="table table-hover small">
                                    <thead>
                                        <tr>
                                            <th>Дата</th>
                                            <th>Кола</th>
                                            <th>Фактура</th>
                                            <th class="text-end">Сума</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var repair in Model.RepairHistory)
                                        {
                                            <tr class="@(repair.IsCancelled ? "bg-light text-muted opacity-75" : "")">
                                                <td>@repair.Date.ToString("dd.MM.yyyy")</td>
                                                <td>@repair.CarModel <br /> <small class="text-muted">@repair.RegistrationNumber</small></td>
                                                <td>
                                                    <a asp-controller="Customers" asp-action="PrintInvoice" asp-route-id="@repair.InvoiceId" target="_blank" class="text-decoration-none fw-bold">
                                                        <i class="bi bi-printer me-1"></i> @repair.InvoiceNumber
                                                    </a>
                                                    @if (repair.IsCancelled)
                                                    {
                                                        <span class="badge bg-danger small ms-1" style="font-size: 0.75rem;">Анулирана</span>
                                                    }
                                                </td>
                                                <td class="text-end fw-bold @(repair.IsCancelled ? "text-decoration-line-through text-danger" : "text-success")">@repair.TotalAmount.ToString("F2") €</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>