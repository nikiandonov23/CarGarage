@model CarGarage.DataModels.Message

@{
    ViewData["Title"] = "Message";
}

<div class="container mt-5">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <strong>From:</strong> @Model.SenderId
                <br />
                <small class="text-muted">@Model.SentAt.ToString("g")</small>
            </div>
            <div>
                <form asp-action="Delete" method="post" style="display:inline-block">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn btn-sm btn-danger">Delete</button>
                </form>
                <a asp-action="Outbox" class="btn btn-sm btn-secondary ms-2">Back</a>
            </div>
        </div>
        <div class="card-body">
            <p>@Model.Content</p>
        </div>
    </div>
</div>
