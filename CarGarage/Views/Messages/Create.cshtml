@model CarGarage.ViewModels.Messages.MessageFormModel

@{
    ViewData["Title"] = "Свържи се със продавача";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 p-3">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="PartId" />
                    <input type="hidden" asp-for="ReceiverId" />
                    <input type="hidden" asp-for="ConversationId" />

                    <div class="mb-3">
                        <label asp-for="Content" class="form-label">Съобщение</label>
                        <textarea asp-for="Content" class="form-control" rows="6"></textarea>
                        <span asp-validation-for="Content" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                            <i class="bi bi-send me-1"></i> Изпрати съобщение
                        </button>
                        <a href="javascript:history.back()" class="btn btn-outline-secondary border shadow-sm">
                            <i class="bi bi-arrow-left-circle me-1"></i> Назад
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
