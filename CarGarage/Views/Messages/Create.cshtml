@model CarGarage.ViewModels.Messages.MessageFormModel

@{
    ViewData["Title"] = "Свържи се със продавача";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            <!-- Create Message Card -->
            <div class="create-message-card">

                <!-- Header -->
                <div class="create-message-header">
                    <i class="bi bi-pencil-square create-message-header-icon"></i>
                    <h1 class="create-message-header-title">Ново съобщение</h1>
                </div>

                <!-- Form -->
                <div class="create-message-form">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="PartId" />
                        <input type="hidden" asp-for="ReceiverId" />
                        <input type="hidden" asp-for="ConversationId" />

                        <!-- Content Field -->
                        <div class="create-message-form-group">
                            <label asp-for="Content" class="create-message-label">
                                Съобщение
                            </label>
                            <textarea asp-for="Content" 
                                      class="create-message-textarea" 
                                      placeholder="Напиши детайлното съобщение..."></textarea>
                            <span asp-validation-for="Content" class="text-danger small d-block mt-2"></span>
                        </div>

                        <!-- Actions -->
                        <div class="create-message-actions">
                            <button type="submit" class="create-message-submit-btn">
                                <i class="bi bi-send me-2"></i>Изпрати съобщение
                            </button>
                            <a href="javascript:history.back()" class="create-message-cancel-btn">
                                <i class="bi bi-arrow-left me-2"></i>Назад
                            </a>
                        </div>

                    </form>
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
