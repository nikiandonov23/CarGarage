@model IEnumerable<CarGarage.DataModels.Message>

@{
    ViewData["Title"] = "Outbox";
}

<div class="container mt-5">
    <h3>Outbox</h3>
    <div class="list-group mt-3">
        @foreach (var msg in Model)
        {
            <a asp-action="Details" asp-route-id="@msg.Id" class="list-group-item list-group-item-action">
                <div class="d-flex w-100 justify-content-between">
                    <h5 class="mb-1">To: @msg.ReceiverId</h5>
                    <small>@msg.SentAt.ToString("g")</small>
                </div>
                <p class="mb-1 text-truncate">@msg.Content</p>
            </a>
        }
    </div>
</div>
