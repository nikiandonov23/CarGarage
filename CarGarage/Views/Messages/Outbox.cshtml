@model IEnumerable<CarGarage.DataModels.Message>

@{
    ViewData["Title"] = "Outbox";
}

<div class="container mt-5 mb-5">

    <!-- Header -->
    <div class="outbox-page-header">
        <h1 class="outbox-page-title">Изпратени</h1>
        <p class="outbox-page-subtitle">Твоите изпратени съобщения</p>
    </div>

    <!-- Outbox Container -->
    <div class="outbox-container">
        @if (!Model.Any())
        {
            <div class="outbox-list-empty">
                <div class="outbox-list-empty-icon">
                    <i class="bi bi-send"></i>
                </div>
                <h5 class="outbox-list-empty-title">Никакви изпратени съобщения</h5>
                <p class="outbox-list-empty-text">Твоите изпратени съобщения ще се появят тук</p>
            </div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var msg in Model)
                {
                    <a asp-action="Details" asp-route-id="@msg.Id" class="outbox-message-item">
                        <div class="outbox-message-header">
                            <h6 class="outbox-message-recipient">
                                За: @msg.ReceiverId
                            </h6>
                            <small class="outbox-message-date">
                                @msg.SentAt.ToString("HH:mm")
                            </small>
                        </div>
                        <p class="outbox-message-preview">
                            @msg.Content
                        </p>
                    </a>
                }
            </div>
        }
    </div>

</div>
