
@model IEnumerable<CarGarage.DataModels.Message>

@using System.Security.Claims

@{
    ViewData["Title"] = "Conversation";

    var currentUserId =
        User.Identity?.IsAuthenticated == true
            ? User.FindFirstValue(
                ClaimTypes.NameIdentifier)
            : null;

    var messages =
        Model.OrderBy(m => m.SentAt).ToList();

    var other =
        messages
            .FirstOrDefault(
                m => m.SenderId != currentUserId)
            ?.SenderId
        ?? messages.FirstOrDefault()?.SenderId;

    var conversationId =
        messages.FirstOrDefault()?.ConversationId;

    var otherGarageName =
        ViewBag.OtherGarageName as string
        ?? other
        ?? "Сервиз";
}

<!-- Header -->
<div class="messages-page-header border-bottom">
    <div class="container">
        <div class="d-flex align-items-center gap-3">
            <a asp-action="Index"
               class="messages-page-back-btn"
               title="Назад">
                <i class="bi bi-chevron-left"></i>
            </a>

            <div>
                <h1 class="messages-conversation-title">@otherGarageName</h1>
                <p class="messages-conversation-subtitle">Чат разговор</p>
            </div>
        </div>
    </div>
</div>

<!-- Chat Container -->
<div class="container mt-4 mb-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            <!-- Chat Card -->
            <div class="messages-chat-card" style="height: calc(100vh - 280px); min-height: 400px;">

                <!-- Messages Container -->
                <div id="messagesContainer" class="messages-container">
                    @if (!messages.Any())
                    {
                        <div class="messages-container-empty">
                            <i class="bi bi-chat-left-text messages-container-empty-icon"></i>
                            <p class="messages-container-empty-text">Няма съобщения</p>
                            <p class="messages-container-empty-text small">Започни разговора!</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var msg in messages)
                        {
                            var isMine = msg.SenderId == currentUserId;

                            <div class="message-bubble @(isMine ? "sent" : "received")">
                                <div class="message-bubble-content">
                                    <div class="message-bubble-sender">
                                        @(isMine ? "Ти" : otherGarageName)
                                    </div>
                                    <div class="message-bubble-text">
                                        @msg.Content
                                    </div>
                                    <div class="message-bubble-time">
                                        @msg.SentAt.ToString("HH:mm")
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Input Section -->
                @if (!string.IsNullOrEmpty(other))
                {
                    <div class="messages-input-section">
                        <form asp-action="Create"
                              method="post"
                              class="messages-input-form">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="ReceiverId"
                                   value="@other" />

                            <input type="hidden"
                                   name="ConversationId"
                                   value="@conversationId" />

                            <input type="hidden"
                                   name="PartId"
                                   value="" />

                            <input type="text"
                                   name="Content"
                                   class="messages-input-field"
                                   placeholder="Напиши съобщение..."
                                   autocomplete="off"
                                   maxlength="2000"
                                   required />

                            <button type="submit"
                                    class="messages-send-btn"
                                    title="Изпрати">
                                <i class="bi bi-send-fill"></i>
                            </button>
                        </form>
                    </div>
                }

            </div>

        </div>
    </div>
</div>


@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const container =
                    document.getElementById(
                        "messagesContainer");

                if (!container) {
                    return;
                }


                // Отиваме на последните съобщения
                container.scrollTop =
                    container.scrollHeight;


                // SignalR connection
                const connection =
                    new signalR.HubConnectionBuilder()
                        .withUrl('/notificationsHub')
                        .withAutomaticReconnect()
                        .build();


                connection.on(
                    'NewMessage',
                    function (message) {

                        // Този разговор ли е?
                        const currentConversationId =
                            '@conversationId';

                        if (
                            message.conversationId !==
                            currentConversationId
                        ) {
                            return;
                        }


                        // Ако съобщението е от нас,
                        // не го добавяме втори път.
                        if (
                            message.senderId ===
                            '@currentUserId'
                        ) {
                            return;
                        }


                        // Премахваме "Няма съобщения"
                        const emptyMessage =
                            document.getElementById(
                                "emptyMessage");

                        if (emptyMessage) {
                            emptyMessage.remove();
                        }


                        // Име на сервиза
                        const senderName =
                            message.senderGarageName
                            || "Сервиз";


                        // Message wrapper
                        const wrapper =
                            document.createElement("div");

                        wrapper.className =
                            "d-flex mb-2 justify-content-start";


                        // Message content
                        wrapper.innerHTML = `
                                    <div style="max-width:65%;">

                                        <div class="small text-muted mb-1"
                                             style="font-size:11px;">
                                            ${escapeHtml(senderName)}
                                        </div>

                                        <div class="px-3 py-2 rounded-4 bg-light text-dark"
                                             style="font-size:14px;">

                                            <div style="white-space:pre-wrap;">
                                                ${escapeHtml(message.content)}
                                            </div>

                                        </div>

                                        <div class="text-muted mt-1"
                                             style="font-size:10px;">
                                            ${formatDate(message.sentAt)}
                                        </div>

                                    </div>
                                `;


                        container.appendChild(wrapper);


                        // Автоматично скролваме надолу
                        container.scrollTo({
                            top: container.scrollHeight,
                            behavior: "smooth"
                        });

                    });


                // HTML защита
                function escapeHtml(value) {

                    if (value == null) {
                        return "";
                    }

                    const div =
                        document.createElement("div");

                    div.textContent = value;

                    return div.innerHTML;
                }


                // Форматиране на дата
                function formatDate(value) {

                    if (!value) {
                        return "";
                    }

                    const date =
                        new Date(value);

                    return date.toLocaleString(
                        "bg-BG",
                        {
                            dateStyle: "short",
                            timeStyle: "short"
                        });
                }


                connection
                    .start()
                    .then(() => {

                        console.log(
                            "Conversation SignalR connected.");

                    })
                    .catch(err => {

                        console.error(
                            "SignalR error:",
                            err);

                    });

            });

    </script>
}

