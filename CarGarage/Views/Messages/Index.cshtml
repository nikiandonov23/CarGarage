@model IEnumerable<CarGarage.ViewModels.Messages.ConversationSummaryViewModel>

@{
    ViewData["Title"] = "Inbox";
}

<div class="container mt-5 mb-5">

    <!-- Header -->
    <div class="messages-list-header">
        <h1 class="messages-list-title">Съобщения</h1>
        <p class="messages-list-subtitle">Твои разговори</p>
    </div>

    <!-- Conversations Container -->
    <div class="messages-list-container">
        @if (!Model.Any())
        {
            <div class="messages-list-empty">
                <div class="messages-list-empty-icon">
                    <i class="bi bi-chat-left-text"></i>
                </div>
                <h5 class="messages-list-empty-title">Никакви съобщения</h5>
                <p class="messages-list-empty-text">Твоите разговори ще се появят тук</p>
            </div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var conv in Model)
                {
                    var isUnread = conv.UnreadCount > 0;

                    <div class="conversation-item @(isUnread ? "unread" : "")">

                        <div class="d-flex align-items-center gap-3">

                            <!-- Avatar -->
                            <div class="conversation-avatar">
                                <i class="bi bi-person-fill"></i>
                            </div>

                            <!-- Content -->
                            <div class="conversation-content">
                                <a asp-action="Details"
                                   asp-route-id="@conv.LatestMessageId"
                                   class="text-decoration-none">

                                    <div class="conversation-header">
                                        <div class="d-flex align-items-center gap-2">
                                            <h6 class="conversation-name">
                                                @conv.OtherUserName
                                            </h6>
                                            @if (isUnread)
                                            {
                                                <span class="conversation-unread-badge">
                                                    @conv.UnreadCount
                                                </span>
                                            }
                                        </div>
                                        <small class="conversation-time">
                                            @conv.LastSentAt.ToString("HH:mm")
                                        </small>
                                    </div>

                                    <p class="conversation-preview">
                                        @conv.LastMessage
                                    </p>
                                </a>
                            </div>

                            <!-- Actions -->
                            <div class="conversation-actions">

                                <!-- Pin / Unpin Button -->
                                <form asp-action="TogglePin" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@conv.LatestMessageId" />
                                    <button type="submit"
                                            class="conversation-action-btn @(conv.IsPinned ? "bg-warning text-white border-warning" : "")"
                                            title="@(conv.IsPinned ? "Откачи" : "Закачи")">
                                        <i class="bi @(conv.IsPinned ? "bi-pin-fill" : "bi-pin")"></i>
                                    </button>
                                </form>

                                <!-- Delete Button -->
                                <a asp-action="Delete"
                                   asp-route-id="@conv.LatestMessageId"
                                   class="conversation-action-btn text-danger"
                                   title="Изтрий разговор">
                                    <i class="bi bi-trash"></i>
                                </a>

                            </div>

                        </div>

                    </div>
                }
            </div>
        }

    </div>

</div>
