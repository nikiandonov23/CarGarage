@model IEnumerable<CarGarage.DataModels.Message>

@{
    ViewData["Title"] = "Inbox";
}

<div class="container mt-5">
    <h3>Inbox</h3>
    <div class="list-group mt-3">
        @foreach (var msg in Model)
        {
            <a asp-action="Index" class="list-group-item list-group-item-action">
                <div class="d-flex w-100 justify-content-between">
                    <h5 class="mb-1">From: @msg.SenderId</h5>
                    <small>@msg.SentAt.ToString("g")</small>
                </div>
                <p class="mb-1 text-truncate">@msg.Content</p>
                <small class="text-muted">Conversation: @msg.ConversationId</small>
            </a>
        }
    </div>
</div>
