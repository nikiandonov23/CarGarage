@model CarGarage.DataModels.Message

@{
    ViewData["Title"] = "Delete Conversation";
}

<div class="container mt-5 mb-5" style="max-width: 600px;">
    <div class="card border-0 shadow-sm rounded-4 p-4">

        <div class="text-center mb-4">
            <div class="mb-3 text-danger">
                <i class="bi bi-exclamation-triangle-fill fs-1"></i>
            </div>
            <h3 class="fw-bold">Confirm Deletion</h3>
            <p class="text-muted mb-0">Are you sure you want to delete this conversation? This action cannot be undone.</p>
        </div>

        @if (Model != null)
        {
            <div class="bg-light p-3 rounded-3 mb-4 border">
                <small class="text-muted d-block mb-1">Last message content:</small>
                <p class="mb-0 fw-semibold text-dark text-truncate">@Model.Content</p>
            </div>
        }

        <form asp-action="Delete" method="post" class="d-flex justify-content-center gap-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model?.Id" />

            <a asp-action="Index" class="btn btn-light rounded-pill px-4">
                Cancel
            </a>

            <button type="submit" class="btn btn-danger rounded-pill px-4">
                Yes, Delete
            </button>
        </form>

    </div>
</div>