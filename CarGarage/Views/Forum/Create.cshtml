@model CarGarage.ViewModels.Forum.ForumPostFormModel

@{
    ViewData["Title"] = "Задайте въпрос";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <!-- Navigation -->
            <div class="mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 py-1 bg-white text-decoration-none">
                    <i class="bi bi-arrow-left me-2"></i>Назад към форума
                </a>
            </div>

            <!-- Create card -->
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="rounded-circle bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                            <i class="bi bi-question-lg fs-3"></i>
                        </div>
                        <h2 class="fw-bold text-dark">Нова тема във форума</h2>
                        <p class="text-muted">Формулирайте ясно въпроса си или опишете техническия казус, за да получите помощ.</p>
                    </div>

                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Title -->
                        <div class="form-floating mb-3">
                            <input asp-for="Title" class="form-control border-light-subtle rounded-3 bg-light" placeholder="Заглавие на темата" />
                            <label asp-for="Title" class="text-muted">Заглавие на темата</label>
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- Cloudflare S3 (R2) Multi-image upload controls -->
                        <div class="mb-4">
                            <label class="form-label text-muted small fw-bold">Прикачи снимки (макс 5 броя)</label>
                            <div class="input-group mb-2">
                                <button type="button" class="btn btn-outline-primary" onclick="document.getElementById('cameraInput').click();">
                                    <i class="bi bi-camera-fill me-1"></i>Отвори Камера
                                </button>
                                <input type="file" id="cameraInput" name="ImageFiles" accept="image/*" capture="environment" multiple style="display:none;" onchange="previewImages(this);" />

                                <button type="button" class="btn btn-outline-secondary ms-2" onclick="document.getElementById('fileInput').click();">
                                    <i class="bi bi-folder-plus me-1"></i>Избери файлове
                                </button>
                                <input type="file" id="fileInput" name="ImageFiles" accept="image/*" multiple style="display:none;" onchange="previewImages(this);" />
                            </div>
                            <span asp-validation-for="ImageFiles" class="text-danger small d-block mb-1"></span>
                            <small class="text-muted d-block mb-3">Снимките се оразмеряват и компресират автоматично за форум-интеграция.</small>

                            <div id="imagePreviewContainer" class="d-flex flex-wrap gap-2 mt-2"></div>
                        </div>

                        <!-- Content -->
                        <div class="form-group mb-4">
                            <label asp-for="Content" class="form-label text-muted small fw-bold">Съдържание на темата / въпроса</label>
                            <textarea asp-for="Content" class="form-control border-light-subtle rounded-3 bg-light" rows="7" placeholder="Опишете подробно проблема, симптомите на колата или опита, който искате да споделите..."></textarea>
                            <span asp-validation-for="Content" class="text-danger small"></span>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4">Отказ</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Публикувай</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImages(input) {
            var container = document.getElementById('imagePreviewContainer');
            if (input.files) {
                var filesCount = input.files.length;
                if (filesCount > 5) {
                    alert("Можете да изберете максимум 5 снимки.");
                    input.value = "";
                    container.innerHTML = "";
                    return;
                }

                container.innerHTML = "";

                for (var i = 0; i < filesCount; i++) {
                    (function(file) {
                        var reader = new FileReader();
                        reader.onload = function(e) {
                            var imgWrapper = document.createElement('div');
                            imgWrapper.className = 'position-relative';
                            imgWrapper.style.width = '100px';
                            imgWrapper.style.height = '100px';
                            imgWrapper.style.border = '1px solid #ddd';
                            imgWrapper.style.borderRadius = '8px';
                            imgWrapper.style.overflow = 'hidden';

                            var img = document.createElement('img');
                            img.src = e.target.result;
                            img.style.width = '100%';
                            img.style.height = '100%';
                            img.style.objectFit = 'cover';

                            imgWrapper.appendChild(img);
                            container.appendChild(imgWrapper);
                        };
                        reader.readAsDataURL(file);
                    })(input.files[i]);
                }
            }
        }
    </script>
}
