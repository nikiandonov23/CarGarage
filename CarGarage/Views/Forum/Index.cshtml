@model IEnumerable<CarGarage.ViewModels.Forum.ForumPostViewModel>
@using System.Security.Claims

@{
    ViewData["Title"] = "Форум";
    var searchString = ViewBag.SearchString as string;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="container my-5">
    <!-- Header -->
    <div class="row align-items-center mb-4">
        <div class="col-md-8">
            <h1 class="display-6 fw-bold text-primary mb-1">
                <i class="bi bi-chat-text-fill me-2 text-primary"></i>Форум на автосервизите
            </h1>
            <p class="text-muted mb-0">Споделяйте опит, задавайте въпроси и помагайте на колеги в реално време.</p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm rounded-pill fw-bold">
                <i class="bi bi-pencil-square me-2"></i>Задай въпрос
            </a>
        </div>
    </div>

    <!-- Search Section -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-light">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="d-flex gap-2">
                <div class="input-group">
                    <span class="input-group-text bg-white border-0 rounded-start-pill ps-3 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="searchString" value="@searchString" class="form-control border-0 rounded-end-pill py-2" placeholder="Търсете теми, ключови думи или въпроси..." />
                </div>
                @if (!string.IsNullOrEmpty(searchString))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 d-flex align-items-center">
                        Изчисти
                    </a>
                }
                <button type="submit" class="btn btn-primary rounded-pill px-4">Търси</button>
            </form>
        </div>
    </div>

    <!-- Feed / Posts list -->
    <div class="row justify-content-center">
        <div class="col-12">
            @if (!Model.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                    <i class="bi bi-chat-square-quote display-3 text-muted mb-3"></i>
                    <h4 class="fw-bold text-secondary">Все още няма публикации</h4>
                    <p class="text-muted max-width-md mx-auto mb-4">Бъдете първият, който ще зададе въпрос или ще сподели нещо важно с останалите колеги!</p>
                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2">
                        <i class="bi bi-plus-lg me-2"></i>Публикувай първи
                    </a>
                </div>
            }
            else
            {
                @foreach (var post in Model)
                {
                    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white hover-post-card transition-all">
                        <div class="card-body p-4">
                            <!-- Author & Date -->
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 48px; height: 48px;">
                                        <i class="bi bi-image-alt fs-5"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0 text-dark">
                                            @post.UserDisplayName
                                        </h6>
                                        @if (!string.IsNullOrEmpty(post.GarageName))
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary small rounded-pill mt-1">
                                                <i class="bi bi-tools me-1"></i>@post.GarageName
                                            </span>
                                        }
                                        <small class="text-muted d-block mt-1">
                                            <i class="bi bi-clock me-1"></i>@post.CreatedAt.ToString("dd.MM.yyyy г. HH:mm ч.")
                                        </small>
                                    </div>
                                </div>

                                <!-- Action actions (Edit / Delete) -->
                                @if (post.UserId == currentUserId)
                                {
                                    <div class="dropdown">
                                        <button class="btn btn-link text-muted p-1" type="button" id="dropdownMenuButton-@post.Id" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical fs-5"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3" aria-labelledby="dropdownMenuButton-@post.Id">
                                            <li>
                                                <a class="dropdown-item py-2" asp-action="Edit" asp-route-id="@post.Id">
                                                    <i class="bi bi-pencil me-2 text-warning"></i>Редактирай
                                                </a>
                                            </li>
                                            <li>
                                                <form asp-action="Delete" asp-route-id="@post.Id" method="post" onsubmit="return confirm('Сигурни ли сте, че искате да изтриете тази публикация?');" class="d-inline">
                                                    <button type="submit" class="dropdown-item py-2 text-danger">
                                                        <i class="bi bi-trash me-2"></i>Изтрий
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                }
                            </div>

                            <!-- Post Title & Content Preview -->
                            <a asp-action="Details" asp-route-id="@post.Id" class="text-decoration-none text-dark d-block">
                                <h4 class="fw-bold mb-2 text-dark hover-title">@post.Title</h4>
                                <p class="card-text text-muted mb-3 fs-6" style="white-space: pre-wrap; line-height: 1.6;">
                                    @(post.Content.Length > 280 ? post.Content.Substring(0, 275) + "..." : post.Content)
                                </p>
                            </a>

                            <!-- Optional Image -->
                            @if (!string.IsNullOrEmpty(post.ImageUrl))
                            {
                                <div class="mb-3 overflow-hidden rounded-4 border bg-light" style="max-height: 380px;">
                                    <a asp-action="Details" asp-route-id="@post.Id">
                                        <img src="@post.ImageUrl" class="img-fluid w-100 h-100 style-img" style="object-fit: cover; max-height: 380px;" alt="Снимка към публикацията" onerror="this.style.display='none';" />
                                    </a>
                                </div>
                            }

                            <hr class="opacity-10 my-3" />

                            <!-- Likes and Comments Actions -->
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex gap-3">
                                    <!-- Like Form -->
                                    <form asp-action="Like" asp-route-id="@post.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm rounded-pill px-3 d-flex align-items-center gap-2 @(post.IsLikedByCurrentUser ? "btn-primary" : "btn-outline-primary") transition-all">
                                            <i class="bi @(post.IsLikedByCurrentUser ? "bi-hand-thumbs-up-fill" : "bi-hand-thumbs-up")"></i>
                                            <span class="fw-bold">@post.LikesCount</span>
                                        </button>
                                    </form>

                                    <!-- Comments button -->
                                    <a asp-action="Details" asp-route-id="@post.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-flex align-items-center gap-2 text-decoration-none">
                                        <i class="bi bi-chat-dots"></i>
                                        <span class="fw-bold">@post.CommentsCount Коментара</span>
                                    </a>
                                </div>

                                <a asp-action="Details" asp-route-id="@post.Id" class="link-primary fw-bold text-decoration-none d-flex align-items-center gap-1 transition-all hover-translate-x">
                                    Виж детайли <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<style>
    .hover-post-card {
        border: 1px solid #f0f0f0;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-post-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.08) !important;
    }
    .hover-title {
        transition: color 0.1s ease;
    }
    .hover-post-card:hover .hover-title {
        color: #0d6efd !important;
    }
    .hover-translate-x:hover {
        transform: translateX(4px);
    }
</style>
