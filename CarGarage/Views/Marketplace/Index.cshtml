@model CarGarage.ViewModels.Marketplace.MarketplaceIndexViewModel
@using System.Security.Claims

@{
    ViewData["Title"] = "Marketplace";
    var currentUserId = User.Identity?.IsAuthenticated == true
        ? User.FindFirstValue(ClaimTypes.NameIdentifier)
        : null;
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">
            Маркетплейс - части за продажба
        </h2>

        <div>
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i>
                Добави обява
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.OwnerId))
    {
        var filteredGarageName = Model.Results.FirstOrDefault(p => p.OwnerId == Model.OwnerId)?.GarageName ?? "избрания сервиз";
        <div class="alert alert-info d-flex justify-content-between align-items-center mb-4 shadow-sm border-0 rounded-3">
            <div class="d-flex align-items-center">
                <i class="bi bi-funnel-fill text-info fs-4 me-3"></i>
                <div>
                    Показване на обяви само за сервиз: <strong>@filteredGarageName</strong>
                </div>
            </div>
            <a asp-action="Index" class="btn btn-sm btn-outline-info">
                <i class="bi bi-x-circle me-1"></i>Изчисти филтъра
            </a>
        </div>
    }

    <!-- Search -->
    <div class="card mb-4 shadow-sm border-0 p-3">
        <form method="get" class="row g-2 align-items-end">
            <input type="hidden" name="ownerId" value="@Model.OwnerId" />

            <div class="col-md-4">
                <label class="form-label small text-muted">
                    Име на част
                </label>
                <input name="searchTerm"
                       value="@Model.SearchTerm"
                       class="form-control"
                       placeholder="напр. филтър, бутало..." />
            </div>

            <div class="col-md-3">
                <label class="form-label small text-muted">
                    Град
                </label>
                <input name="city"
                       value="@Model.City"
                       class="form-control"
                       placeholder="напр. София" />
            </div>

            <div class="col-md-3">
                <label class="form-label small text-muted">
                    Категория
                </label>
                <select name="categoryId" class="form-select">
                    <option value="">Всички</option>
                    @foreach (var c in Model.Categories ?? Enumerable.Empty<CarGarage.ViewModels.Parts.PartCategoryViewModel>())
                    {
                        <option value="@c.Id"
                                selected="@(Model.CategoryId == c.Id ? "selected" : null)">
                            @c.Name
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <div class="d-grid">
                    <button class="btn btn-outline-primary">
                        Търси
                    </button>
                </div>
            </div>

        </form>
    </div>

    <!-- Marketplace Results -->
    <div class="row">

        @if (!Model.Results.Any())
        {
            <div class="col-12">
                <div class="card p-4 text-center text-muted">
                    Няма намерени обяви.
                </div>
            </div>
        }
        else
        {
            @foreach (var item in Model.Results)
            {
                <div class="col-md-4 mb-4">

                    <div class="card shadow-sm h-100">

                        <!-- Status -->
                        <div class="position-absolute"
                             style="right:10px; top:10px; z-index:5;">
                            @if (item.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>
                            }
                            else if (item.Status == "Available")
                            {
                                <span class="badge bg-success">
                                    Available
                                </span>
                            }
                        </div>

                        <!-- Image (Кликаема е) -->
                        @if (item.PartImages != null && item.PartImages.Any())
                        {
                            <a asp-action="Details" asp-route-id="@item.Id">
                                <img src="@item.PartImages.First().ImageUrl"
                                     class="card-img-top"
                                     style="height:180px; object-fit:cover;"
                                     alt="@item.Name" />
                            </a>
                        }
                        else if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <a asp-action="Details" asp-route-id="@item.Id">
                                <img src="@item.ImageUrl"
                                     class="card-img-top"
                                     style="height:180px; object-fit:cover;"
                                     alt="@item.Name" />
                            </a>
                        }
                        else
                        {
                            <a asp-action="Details" asp-route-id="@item.Id" class="d-block bg-light text-center text-muted" style="height:180px; line-height:180px;">
                                <i class="bi bi-image fs-1"></i>
                            </a>
                        }

                        <div class="card-body d-flex flex-column">

                            <!-- Заглавие (Кликаем линк към детайлите) -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold mb-0">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="text-dark text-decoration-none">
                                        @item.Name
                                    </a>
                                </h5>
                                @if (!string.IsNullOrEmpty(currentUserId) && item.OwnerId == currentUserId)
                                {
                                    <div class="dropdown">
                                        <button class="btn btn-link text-muted p-0" type="button" id="dropdownMenuButton-@item.Id" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical fs-5"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3" aria-labelledby="dropdownMenuButton-@item.Id">
                                            <li>
                                                <a class="dropdown-item py-2" asp-action="Edit" asp-route-id="@item.Id">
                                                    <i class="bi bi-pencil me-2 text-warning"></i>Редактирай
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item py-2 text-danger" asp-action="Delete" asp-route-id="@item.Id">
                                                    <i class="bi bi-trash me-2"></i>Изтрий
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                }
                            </div>

                            <p class="card-text text-muted small mb-1">
                                Категория: @item.CategoryName
                            </p>

                            <p class="card-text small mb-2">
                                @item.GarageName
                                @if (!string.IsNullOrEmpty(item.City))
                                {
                                    <span class="text-muted">
                                        (@item.City)
                                    </span>
                                }
                            </p>

                            <div class="mt-auto d-flex justify-content-between align-items-center">

                                <div class="fw-bold text-dark fs-5">
                                    @item.Price.ToString("N2") €
                                </div>

                                <div class="d-flex gap-2">

                                    <!-- Детайли (Преведено и с иконка) -->
                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-secondary shadow-sm rounded-3"
                                       title="Детайли">
                                        <i class="bi bi-eye-fill fs-5"></i>
                                    </a>

                                    <!-- Actions for other users only -->
                                    @if (!string.IsNullOrEmpty(currentUserId)
                                         && item.OwnerId != currentUserId)
                                    {
                                        <a asp-controller="Messages"
                                           asp-action="Create"
                                           asp-route-partId="@item.Id"
                                           class="btn btn-primary shadow-sm rounded-3"
                                           title="Изпрати съобщение">
                                            <i class="bi bi-chat-text-fill fs-5"></i>
                                        </a>

                                        @if (!string.IsNullOrWhiteSpace(item.Phone))
                                        {
                                            <a href="tel:@item.Phone"
                                               class="btn btn-success shadow-sm rounded-3"
                                               title="Обади се">
                                                <i class="bi bi-telephone-fill fs-5"></i>
                                            </a>
                                        }

                                        <a asp-controller="Offers"
                                           asp-action="MakeOffer"
                                           asp-route-partId="@item.Id"
                                           class="btn btn-info text-white shadow-sm rounded-3"
                                           title="Направи оферта">
                                            <i class="bi bi-cash-coin fs-5"></i>
                                        </a>
                                    }

                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            }
        }

    </div>
</div>