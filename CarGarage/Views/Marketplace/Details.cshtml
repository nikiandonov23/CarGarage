@model CarGarage.ViewModels.Marketplace.PartForSaleViewModel

@{
    ViewData["Title"] = "Детайли";
}

<div class="container mt-5">
    <div class="row">

        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <!-- Кликаема снимка с лупичка и lightbox ефект -->
                    <a href="@Model.ImageUrl"
                       class="image-zoom-container glightbox d-block"
                       data-gallery="part-images"
                       title="@Model.Name">

                        <img src="@Model.ImageUrl"
                             class="img-fluid w-100"
                             style="max-height:500px; object-fit:cover;"
                             alt="@Model.Name" />
                    </a>
                }
            </div>
        </div>

        <div class="col-md-6">

            <h2 class="fw-bold">@Model.Name</h2>

            <p class="text-muted small">
                Категория: @Model.CategoryName
            </p>

            <p class="fs-4 text-primary fw-bold">
                @Model.Price.ToString("N2") €
            </p>

            <p class="mb-3" style="white-space: pre-line;">
                @Model.Description
            </p>

            <div class="d-flex gap-2">

                @if (ViewBag.IsOwner == true)
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-secondary">
                        Редактирай
                    </a>
                }

                <a asp-action="Index"
                   class="btn btn-light">
                    Назад
                </a>

            </div>

            <hr />

            <!-- Actions for other users only -->
            @if (ViewBag.IsOwner != true)
            {
                <div class="mt-3 d-flex flex-wrap gap-2">

                    <a asp-controller="Messages"
                       asp-action="Create"
                       asp-route-partId="@Model.Id"
                       asp-route-receiverId="@Model.OwnerId"
                       class="btn btn-success">
                        Изпрати съобщение
                    </a>

                    @if (!string.IsNullOrWhiteSpace(Model.Phone))
                    {
                        <a href="tel:@Model.Phone"
                           class="btn btn-outline-primary">
                            Обади се
                        </a>
                    }

                    <a asp-controller="Offers"
                       asp-action="MakeOffer"
                       asp-route-partId="@Model.Id"
                       class="btn btn-outline-primary">
                        Направи оферта
                    </a>

                </div>
            }

            <div class="mt-4 text-muted small">

                Добавено: @Model.DateAdded.ToString("g")

                <div>
                    @if (Model.Status == "Pending")
                    {
                        <span class="badge bg-warning text-dark">
                            Pending
                        </span>
                    }
                    else if (Model.Status == "Available")
                    {
                        <span class="badge bg-success">
                            Available
                        </span>
                    }
                    else if (!string.IsNullOrEmpty(Model.Status))
                    {
                        <span class="badge bg-secondary">
                            @Model.Status
                        </span>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.GarageName))
                {
                    <div>
                        Сервиз: @Model.GarageName

                        @if (!string.IsNullOrEmpty(Model.City))
                        {
                            <span>(@Model.City)</span>
                        }
                    </div>
                }

            </div>

        </div>
    </div>
</div>