@model CarGarage.ViewModels.Marketplace.PartForSaleViewModel

@{
    ViewData["Title"] = "Детайли";
}

<div class="container mt-5">
    <div class="row">

        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                @if (Model.PartImages != null && Model.PartImages.Any())
                {
                    var carouselId = $"carouselPart{Model.Id}";
                    <div id="@carouselId" class="carousel slide border rounded" data-bs-ride="false" style="overflow: hidden; max-height: 500px;">
                        <div class="carousel-indicators">
                            @for (int idx = 0; idx < Model.PartImages.Count; idx++)
                            {
                                <button type="button" data-bs-target="#@carouselId" data-bs-slide-to="@idx" class="@(idx == 0 ? "active" : "")" aria-current="@(idx == 0 ? "true" : "false")" aria-label="Слайд @(idx + 1)"></button>
                            }
                        </div>
                        <div class="carousel-inner" style="height: 500px;">
                            @for (int idx = 0; idx < Model.PartImages.Count; idx++)
                            {
                                var img = Model.PartImages[idx];
                                <div class="carousel-item @(idx == 0 ? "active" : "")" style="height: 500px;">
                                    <a href="@img.ImageUrl" class="glightbox d-block h-100 w-100" data-gallery="part-images">
                                        <img src="@img.ImageUrl" class="d-block w-100 h-100" style="object-fit: cover;" alt="@Model.Name">
                                    </a>
                                </div>
                            }
                        </div>
                        @if (Model.PartImages.Count > 1)
                        {
                            <button class="carousel-control-prev" type="button" data-bs-target="#@carouselId" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Предишна</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#@carouselId" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Следваща</span>
                            </button>
                        }
                    </div>
                }
                else if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <!-- Кликаема снимка с лупичка и lightbox ефект -->
                    <a href="@Model.ImageUrl"
                       class="image-zoom-container glightbox d-block"
                       data-gallery="part-images"
                       title="@Model.Name">

                        <img src="@Model.ImageUrl"
                             class="img-fluid w-100"
                             style="max-height:500px; object-fit:cover;"
                             alt="@Model.Name" />
                    </a>
                }
                else
                {
                    <div class="bg-light text-center py-5 border rounded" style="height: 400px; line-height: 300px;">
                        <i class="bi bi-image-fill display-1 text-secondary"></i>
                    </div>
                }
            </div>
        </div>

        <div class="col-md-6">

            <h2 class="fw-bold">@Model.Name</h2>

            <p class="text-muted small">
                Категория: @Model.CategoryName
            </p>

            <p class="fs-4 text-primary fw-bold">
                @Model.Price.ToString("N2") €
            </p>

            <p class="mb-3" style="white-space: pre-line;">
                @Model.Description
            </p>

            <div class="d-flex gap-2">

                @if (ViewBag.IsOwner == true)
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-secondary">
                        Редактирай
                    </a>
                }

                <a asp-action="Index"
                   class="btn btn-light">
                    Назад
                </a>

            </div>

            <hr />

            <!-- Actions for other users only -->
            @if (ViewBag.IsOwner != true)
            {
                <div class="mt-3 d-flex flex-wrap gap-2">

                    <a asp-controller="Messages"
                       asp-action="Create"
                       asp-route-partId="@Model.Id"
                       asp-route-receiverId="@Model.OwnerId"
                       class="btn btn-success">
                        Изпрати съобщение
                    </a>

                    @if (!string.IsNullOrWhiteSpace(Model.Phone))
                    {
                        <a href="tel:@Model.Phone"
                           class="btn btn-outline-primary">
                            Обади се
                        </a>
                    }

                    <a asp-controller="Offers"
                       asp-action="MakeOffer"
                       asp-route-partId="@Model.Id"
                       class="btn btn-outline-primary">
                        Направи оферта
                    </a>

                </div>
            }

            <div class="mt-4 text-muted small">

                Добавено: @Model.DateAdded.ToString("g")

                <div>
                    @if (Model.Status == "Pending")
                    {
                        <span class="badge bg-warning text-dark">
                            Pending
                        </span>
                    }
                    else if (Model.Status == "Available")
                    {
                        <span class="badge bg-success">
                            Available
                        </span>
                    }
                    else if (!string.IsNullOrEmpty(Model.Status))
                    {
                        <span class="badge bg-secondary">
                            @Model.Status
                        </span>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.GarageName))
                {
                    <div>
                        Сервиз: @Model.GarageName

                        @if (!string.IsNullOrEmpty(Model.City))
                        {
                            <span>(@Model.City)</span>
                        }
                    </div>
                }

            </div>

        </div>
    </div>
</div>