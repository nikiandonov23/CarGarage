@model IEnumerable<CarGarage.ViewModels.Garage.GarageMapViewModel>

@{
    ViewData["Title"] = "Намери сервиз";
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.4.1/dist/MarkerCluster.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.4.1/dist/MarkerCluster.Default.css" />

    <style>
        #garages-map {
            height: 650px;
            width: 100%;
            z-index: 1;
        }

        .leaflet-popup-content-wrapper {
            border-radius: 12px;
            padding: 5px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
        }

        .leaflet-popup-content {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 14px;
            color: #333;
            margin: 12px;
            line-height: 1.5;
        }

        .popup-title {
            font-size: 16px;
            font-weight: 700;
            color: #0d6efd;
            margin-bottom: 6px;
            border-bottom: 1px solid #eee;
            padding-bottom: 4px;
        }

        .popup-info-row {
            display: flex;
            align-items: center;
            margin-bottom: 5px;
        }

        .popup-info-icon {
            color: #6c757d;
            margin-right: 8px;
            font-size: 15px;
        }

        .popup-actions {
            margin-top: 12px;
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .popup-actions .btn {
            border-radius: 6px;
            font-weight: 600;
            font-size: 12px;
            padding: 5px 10px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }
    </style>
}

<div class="container my-4">
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h1 class="display-5 fw-bold text-primary mb-2">Намери автосервиз</h1>
            <p class="lead text-muted mb-0">Търси и открий всички регистрирани автосервизи на интерактивната карта на България.</p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Назад към началото
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div id="garages-map"></div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-lg-12">
            <div class="alert alert-light border shadow-sm p-3 rounded-3 d-flex align-items-center">
                <i class="bi bi-info-circle-fill text-info fs-4 me-3"></i>
                <div class="small text-muted">
                    <strong>Указание за ползване:</strong> Можете да навигирате по картата, да я увеличавате или намалявате. Кликнете върху някое от габърчетата (или клъстерите в даден град), за да видите контактната информация на сервиза, след което използвайте предоставените действия за връзка.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="https://unpkg.com/leaflet.markercluster@1.4.1/dist/leaflet.markercluster.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Центриране на картата върху България
            var map = L.map('garages-map').setView([42.7339, 25.4858], 7);

            // Добавяне на OpenStreetMap слой
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);

            // Групиране на маркерите за предотвратяване на преливане в един град
            var markers = L.markerClusterGroup({
                spiderfyOnMaxZoom: true,
                showCoverageOnHover: false,
                zoomToBoundsOnClick: true
            });

            // Десериализация на данните за сервизите от модела
            var garages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

            if (garages && garages.length > 0) {
                garages.forEach(function (g) {
                    if (g.Latitude && g.Longitude) {
                        // Създаване на маркер
                        var marker = L.marker([g.Latitude, g.Longitude]);

                        // Дефиниране на HTML съдържанието за popup прозореца
                        var popupHtml = '<div class="popup-title">' + escapeHtml(g.Name) + '</div>';

                        if (g.OwnerName) {
                            popupHtml += '<div class="popup-info-row"><i class="bi bi-person popup-info-icon"></i>' + escapeHtml(g.OwnerName) + '</div>';
                        }

                        popupHtml += '<div class="popup-info-row"><i class="bi bi-geo-alt popup-info-icon"></i>' + escapeHtml(g.City) + (g.Address ? ', ' + escapeHtml(g.Address) : '') + '</div>';

                        if (g.PhoneNumber) {
                            popupHtml += '<div class="popup-info-row"><i class="bi bi-telephone popup-info-icon"></i>' + escapeHtml(g.PhoneNumber) + '</div>';
                        }

                        // Секция действия
                        popupHtml += '<div class="popup-actions">';

                        // Бутон Обаждане
                        if (g.PhoneNumber) {
                            popupHtml += '<a href="tel:' + g.PhoneNumber + '" class="btn btn-outline-success"><i class="bi bi-telephone-fill me-1"></i>Обаждане</a>';
                        }

                        // Бутон Съобщение
                        popupHtml += '<a href="/Messages/Create?receiverId=' + g.OwnerId + '" class="btn btn-outline-info text-dark"><i class="bi bi-envelope-fill me-1"></i>Съобщение</a>';

                        // Бутон Marketplace с филтър
                        popupHtml += '<a href="/Marketplace/Index?ownerId=' + g.OwnerId + '" class="btn btn-primary"><i class="bi bi-shop-window me-1"></i>Обяви в Маркет</a>';

                        popupHtml += '</div>';

                        marker.bindPopup(popupHtml, {
                            maxWidth: 320,
                            minWidth: 260
                        });

                        markers.addLayer(marker);
                    }
                });

                map.addLayer(markers);
            }

            // Функция за защита от HTML инжектиране
            function escapeHtml(string) {
                return String(string).replace(/[&<>"'\/]/g, function (s) {
                    var entityMap = {
                        '&': '&amp;',
                        '<': '&lt;',
                        '>': '&gt;',
                        '"': '&quot;',
                        "'": '&#39;',
                        '/': '&#x2F;'
                    };
                    return entityMap[s];
                });
            }
        });
    </script>
}
