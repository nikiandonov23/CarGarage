@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav align-items-center gap-1">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item dropdown ms-2">
        <a class="nav-link dropdown-toggle btn btn-light rounded-pill px-3 shadow-sm d-flex align-items-center gap-2 border text-decoration-none" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="user-avatar bg-primary text-white d-flex align-items-center justify-content-center fw-bold rounded-circle" style="width: 28px; height: 28px; font-size: 0.85rem;">
                <i class="bi bi-person-fill"></i>
            </div>
            <span class="fw-semibold text-dark">@User.Identity?.Name</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 p-2 mt-2" aria-labelledby="userDropdown" style="min-width: 220px; animation: fadeInUp 0.25s ease;">
            <li>
                <div class="px-3 py-2 mb-2 border-bottom bg-light rounded-3 text-center small text-muted">
                    <i class="bi bi-shield-check text-success me-1"></i>Влязъл в профил
                </div>
            </li>
            <li>
                <a class="dropdown-item rounded-3 py-2" asp-area="Identity" asp-page="/Account/Manage/Index">
                    <i class="bi bi-person-gear me-2 text-primary"></i>Настройки на профила
                </a>
            </li>
            <li>
                <a class="dropdown-item rounded-3 py-2" asp-controller="MyGarage" asp-action="Index">
                    <i class="bi bi-grid-1x2-fill me-2 text-info"></i>Моят гараж
                </a>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <form class="m-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                    <button type="submit" class="dropdown-item rounded-3 py-2 text-danger fw-bold border-0 bg-transparent w-100 text-start">
                        <i class="bi bi-box-arrow-right me-2"></i>Изход
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item me-1">
        <a class="nav-link btn btn-link text-decoration-none text-secondary px-3 py-2 fw-semibold rounded-pill transition-all animate-btn" asp-area="Identity" asp-page="/Account/Login">
            <i class="bi bi-box-arrow-in-right me-1"></i> Вход
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link btn btn-primary text-white px-3 py-2 fw-bold shadow-sm rounded-pill transition-all bg-gradient text-decoration-none border-0" style="background: linear-gradient(135deg, #0d6efd, #0b5ed7);" asp-area="Identity" asp-page="/Account/Register">
            <i class="bi bi-person-plus-fill me-1"></i> Регистрация
        </a>
    </li>
}
</ul>
