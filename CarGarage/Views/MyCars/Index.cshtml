@model CarGarage.ViewModels.Cars.IndexMyCarsViewModel

@{
    ViewData["Title"] = ViewBag.SingleCarView == true ? "Картон на автомобил" : "Моите автомобили";
}

<div class="container my-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-5 fw-bold text-primary mb-0">@(ViewBag.SingleCarView == true ? "Картон на автомобил" : "Моите автомобили")</h1>
        </div>

        <div class="d-flex gap-2">
            @if (ViewBag.SingleCarView == true)
            {
                <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg shadow-sm">
                    <i class="bi bi-arrow-left me-2"></i>Назад
                </a>
            }
            else
            {
                <a asp-controller="MyGarage" asp-action="Index" class="btn btn-outline-secondary btn-lg shadow-sm">
                    <i class="bi bi-house-door me-2"></i>Моят Гараж
                </a>

                <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
                    <i class="bi bi-plus-circle me-2"></i>Добави автомобил
                </a>
            }
        </div>
    </div>

    @* ТЪРСАЧКА *@
    @if (ViewBag.SingleCarView != true && Model != null)
    {
        <div class="card shadow-sm border-0 mb-5 bg-white rounded-4">
            <div class="card-body p-4">
                <form method="get" asp-controller="MyCars" asp-action="Index" class="row g-3">

                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-uppercase text-muted">Рег. номер / VIN</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                            <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control bg-light border-0 shadow-none" placeholder="Въведи номер...">
                        </div>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-uppercase text-muted">Име на клиент</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-person"></i></span>
                            <input type="text" name="customerName" value="@Model.CustomerName" class="form-control bg-light border-0 shadow-none" placeholder="Име на клиент...">
                        </div>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold small text-uppercase text-muted">Марка</label>
                        <select asp-for="MakeId" class="form-select bg-light border-0 shadow-none" id="makeSelect"
                                asp-items="@(new SelectList(Model.Makes, "Id", "Name"))">
                            <option value="">-- Всички марки --</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold small text-uppercase text-muted">Модел</label>
                        <select asp-for="ModelId" class="form-select bg-light border-0 shadow-none" id="modelSelect"
                                asp-items="@(new SelectList(Model.Models, "Id", "Name"))">
                            <option value="">-- Всички модели --</option>
                        </select>
                    </div>

                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100 shadow-sm py-2 fw-bold">
                            Филтрирай
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (Model == null || !Model.Cars.Any())
    {
        <div class="text-center py-5 shadow-sm bg-light rounded border">
            <i class="bi bi-car-front display-1 text-muted"></i>
            @if (Model != null && (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.CustomerName) || Model.MakeId > 0))
            {
                <h3 class="mt-3">Няма намерени автомобили по зададените филтри.</h3>
                <p class="text-muted">Пробвайте да изчистите търсенето или да въведете други критерии.</p>
                <a asp-action="Index" class="btn btn-outline-secondary mt-2">Изчисти филтрите</a>
            }
            else
            {
                <h3 class="mt-3">Все още нямате добавени автомобили.</h3>
                <p class="text-muted">Започнете, като добавите първата си кола.</p>
            }
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var car in Model.Cars)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 transition-card">
                        @* БЪРЗИ ВРЪЗКИ ЗА ДЪРЖАВНИ РЕГИСТРИ *@
                        <div class="mb-3 pt-2 border-top">
                            <span class="d-block small text-muted mb-2 text-center fw-bold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px;">Проверки в държавни регистри</span>
                            <div class="d-flex justify-content-between gap-1">
                                <a href="https://www.guaranteefund.org/bg/%D0%B8%D0%BD%D1%84%D0%BE%D1%80%D0%BC%D0%B0%D1%86%D0%B8%D0%BE%D0%BD%D0%B5%D0%BD-%D1%86%D0%B5%D0%BD%D1%82%D1%8A%D1%80-%D0%B8-%D1%81%D0%BF%D1%80%D0%B0%D0%B2%D0%BA%D0%B8/%D1%83%D1%81%D0%BB%D1%83%D0%B3%D0%B8/%D0%BF%D1%80%D0%BE%D0%B2%D0%B5%D1%80%D0%BA%D0%B0-%D0%B7%D0%B0-%D0%B2%D0%B0%D0%BB%D0%B8%D0%B4%D0%BD%D0%B0-%D0%B7%D0%B0%D1%81%D1%82%D1%80%D0%B0%D1%85%D0%BE%D0%B2%D0%BA%D0%B0-%D0%B3%D1%80%D0%B0%D0%BD%D0%B8%D1%87%D0%BD%D0%B0-%D0%B3%D1%80%D0%B0%D0%B6%D0%B4%D0%B0%D0%BD%D1%81%D0%BA%D0%B0-%D0%BE%D1%82%D0%B3%D0%BE%D0%B2%D0%BE%D1%80%D0%BD%D0%BE%D1%81%D1%82" target="_blank" class="btn btn-outline-info btn-sm flex-fill d-flex align-items-center justify-content-center gap-1 py-2 fw-semibold" title="Проверка на Гражданска отговорност (ГО)">
                                    <i class="bi bi-shield-check"></i> ГО
                                </a>
                                <a href="https://rta.government.bg/services/check-inspection/index.html" target="_blank" class="btn btn-outline-dark btn-sm flex-fill d-flex align-items-center justify-content-center gap-1 py-2 fw-semibold" title="Проверка на Технически преглед (ГТП)">
                                    <i class="bi bi-clipboard2-check"></i> ГТП
                                </a>
                                <a href="https://check.bgtoll.bg/" target="_blank" class="btn btn-outline-success btn-sm flex-fill d-flex align-items-center justify-content-center gap-1 py-2 fw-semibold" title="Проверка за активна Винетка">
                                    <i class="bi bi-award"></i> Винетка
                                </a>
                            </div>
                        </div>
                        @if (car.CarImages != null && car.CarImages.Any())
                        {
                            var carouselId = $"carouselCar{car.Id}";
                            <div id="@carouselId" class="carousel slide border-bottom" data-bs-ride="false">
                                <div class="carousel-indicators">
                                    @for (int idx = 0; idx < car.CarImages.Count; idx++)
                                    {
                                        <button type="button" data-bs-target="#@carouselId" data-bs-slide-to="@idx" class="@(idx == 0 ? "active" : "")" aria-current="@(idx == 0 ? "true" : "false")" aria-label="Слайд @(idx + 1)"></button>
                                    }
                                </div>
                                <div class="carousel-inner" style="height: 200px;">
                                    @for (int idx = 0; idx < car.CarImages.Count; idx++)
                                    {
                                        var img = car.CarImages[idx];
                                        <div class="carousel-item @(idx == 0 ? "active" : "")" style="height: 200px;">
                                            <a href="@img.ImageUrl" target="_blank" title="Виж снимката в голям размер">
                                                <img src="@img.ImageUrl" class="d-block w-100 h-100" style="object-fit: cover;" alt="Снимка на кола">
                                            </a>
                                        </div>
                                    }
                                </div>
                                @if (car.CarImages.Count > 1)
                                {
                                    <button class="carousel-control-prev" type="button" data-bs-target="#@carouselId" data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden">Предишна</span>
                                    </button>
                                    <button class="carousel-control-next" type="button" data-bs-target="#@carouselId" data-bs-slide="next">
                                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden">Следваща</span>
                                    </button>
                                }
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(car.ImageUrl))
                        {
                            <img src="@car.ImageUrl" class="card-img-top border-bottom" alt="Car Image" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-light text-center py-5 border-bottom" style="height: 200px;">
                                <i class="bi bi-car-front-fill display-2 text-secondary"></i>
                            </div>
                        }

                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold mb-0">@car.Make @car.Model</h5>
                                <span class="badge bg-primary rounded-pill">@car.ModelYear</span>
                            </div>

                            <hr class="text-muted opacity-25">

                            <p class="card-text mb-1 d-flex align-items-center justify-content-between">
                                <span>
                                    <i class="bi bi-hash text-primary me-2"></i><strong>Рег. номер:</strong>
                                    <span class="text-uppercase text-secondary" id="reg-@car.Id">@(car.RegistrationNumber ?? "Няма")</span>
                                </span>
                                @if (!string.IsNullOrEmpty(car.RegistrationNumber))
                                {
                                    <button class="btn btn-link p-0 text-muted hover-primary ms-2 btn-copy" data-copy-target="reg-@car.Id" title="Копирай регистрационен номер">
                                        <i class="bi bi-clipboard"></i>
                                    </button>
                                }
                            </p>

                            <p class="card-text mb-1 d-flex align-items-center justify-content-between">
                                <span>
                                    <i class="bi bi-key-fill text-primary me-2"></i><strong>VIN:</strong>
                                    <span class="text-uppercase text-secondary" id="vin-@car.Id">@(string.IsNullOrEmpty(car.Vin) ? "Няма" : car.Vin)</span>
                                </span>
                                @if (!string.IsNullOrEmpty(car.Vin))
                                {
                                    <button class="btn btn-link p-0 text-muted hover-primary ms-2 btn-copy" data-copy-target="vin-@car.Id" title="Копирай VIN номер">
                                        <i class="bi bi-clipboard"></i>
                                    </button>
                                }
                            </p>

                            <p class="card-text mb-1">
                                <i class="bi bi-speedometer2 text-primary me-2"></i><strong>Пробег:</strong>
                                <span class="text-secondary">@(car.Mileage?.ToString("N0") ?? "0") км</span>
                            </p>

                            <p class="card-text mb-2">
                                <i class="bi bi-calendar-event text-primary me-2"></i><strong>Добавена на:</strong>
                                <span class="text-secondary">@car.AddedDate.ToString("dd.MM.yyyy") г.</span>
                            </p>

                            @if (!string.IsNullOrWhiteSpace(car.Notes))
                            {
                                <div class="mt-3 p-3 bg-light rounded-3 border-start border-primary border-4">
                                    <small class="fw-bold text-muted d-block text-uppercase small mb-1">Бележки:</small>
                                    <p class="card-text small text-dark mb-0">@car.Notes</p>
                                </div>
                            }
                        </div>

                        <div class="card-footer bg-transparent border-0 pb-3">
                         
                           
                            <div class="mb-2">
                                <a asp-controller="Parts" asp-action="Index" asp-route-carId="@car.Id" class="btn btn-primary w-100 shadow-sm">
                                    <i class="bi bi-wrench-adjustable me-2"></i>Части и ремонти
                                </a>
                            </div>


                            <div class="mb-2">
                                <a asp-controller="Invoices" asp-action="Create" asp-route-carId="@car.Id" class="btn btn-warning w-100 shadow-sm fw-bold">
                                    <i class="bi bi-receipt me-2"></i>Генерирай Фактура
                                </a>
                            </div>

                           

                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@car.Id" class="btn btn-outline-secondary flex-grow-1">
                                    <i class="bi bi-pencil me-1"></i> Редакция на автомобила
                                </a>

                                <a asp-action="Delete" asp-route-id="@car.Id" class="btn btn-outline-danger flex-grow-1">
                                    <i class="bi bi-trash me-1"></i> Изтрий
                                </a>
                            </div>
                         
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .transition-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .transition-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {

            $('.btn-copy').on('click', function (e) {
                e.preventDefault();
                var targetId = $(this).data('copy-target');
                var textToCopy = $('#' + targetId).text().trim();
                var $btn = $(this);
                var $icon = $btn.find('i');

                if (textToCopy && textToCopy !== "Няма") {
                    navigator.clipboard.writeText(textToCopy).then(function() {
                        $icon.removeClass('bi-clipboard').addClass('bi-clipboard-check text-success');
                        setTimeout(function() {
                            $icon.removeClass('bi-clipboard-check text-success').addClass('bi-clipboard');
                        }, 2000);
                    }).catch(function(err) {
                        console.error('Неуспешно копиране: ', err);
                    });
                }
            });

            $('#makeSelect').on('change', function () {
                var makeId = $(this).val();
                var $modelSelect = $('#modelSelect');

                $modelSelect.empty().append('<option value="">-- Всички модели --</option>');

                if (makeId) {
                    $.getJSON('/MyCars/GetModelsByMake?makeId=' + makeId, function (data) {
                        $.each(data, function (index, item) {
                            $modelSelect.append($('<option>', {
                                value: item.id,
                                text: item.name
                            }));
                        });
                    });
                }
            });
        });
    </script>
}